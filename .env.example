# StudyMind Environment Configuration
# Application Environment
STUDYMIND_ENV=development

# Secret key for session management and token generation
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database Configuration (SQLite)
DATABASE_PATH=data/studymind.db

# LLM Integration Provider (default offline)
# Options: offline, mistral, openai, gemini, openrouter
LLM_PROVIDER=offline

# Mistral API Key (empty by default)
MISTRAL_API_KEY=

# OpenRouter API Key (empty by default)
OPENROUTER_API_KEY=

# Model Name (e.g. mistral-small-latest, empty by default)
MODEL_NAME=
