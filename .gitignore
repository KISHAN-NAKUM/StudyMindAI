# ==============================================================================
# StudyMindAI .gitignore
# ==============================================================================

# Critical Security & Credentials (NEVER COMMIT API KEYS)
.env
.env.*
.env.local
!.env.example

# Byte-compiled / optimized / Python caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Local SQLite Database (auto-generated & seeded on startup)
data/studymind.db
*.db
*.sqlite
*.sqlite3

# Test & Coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Temporary, build, and distribution files
build/
dist/
*.egg-info/
*.zip
SMA_clean.zip
*.log

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor configurations
.idea/
.vscode/
*.swp
*.swo
*~
